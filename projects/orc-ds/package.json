{
  "name": "@ciag/orchestra",
  "version": "22.0.2",
  "description": "Enterprise Angular Component Framework and Design System",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "ui-framework",
    "signals",
    "accessibility"
  ],
  "author": "CIAG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenCIAg/orchestra"
  },
  "style": "styles/index.scss",
  "sass": "styles/index.scss",
  "sideEffects": [
    "styles/**/*.scss",
    "styles/**/*.css"
  ],
  "exports": {
    "./styles": {
      "sass": "./styles/index.scss",
      "default": "./styles/index.scss"
    },
    "./styles/index": {
      "sass": "./styles/index.scss",
      "default": "./styles/index.scss"
    },
    "./styles/index.scss": {
      "sass": "./styles/index.scss",
      "default": "./styles/index.scss"
    },
    "./styles/core": {
      "sass": "./styles/core.scss",
      "default": "./styles/core.scss"
    },
    "./styles/core.scss": {
      "sass": "./styles/core.scss",
      "default": "./styles/core.scss"
    },
    "./styles/*": {
      "sass": "./styles/*",
      "default": "./styles/*"
    }
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
