{
  "name": "orc-ds-workspace",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "dist/orc-ds"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve docs",
    "start:template": "ng serve template --port 4300",
    "build": "ng build orc-ds && ng build docs && ng build template",
    "build:lib": "ng build orc-ds",
    "build:docs": "ng build docs",
    "build:template": "ng build template",
    "watch:lib": "ng build orc-ds --watch --configuration development",
    "test": "npm run test:lib",
    "test:lib": "ng test orc-ds --watch=false --browsers=ChromeHeadless",
    "test:lib:ci": "ng test orc-ds --watch=false --browsers=ChromeHeadlessCI",
    "test:tools": "node --test \"tools/release/*.test.mjs\"",
    "test:themes:ci": "node tools/quality/test-themes.mjs",
    "test:docs": "ng test docs --watch=false --browsers=ChromeHeadless",
    "test:browser:interactions": "playwright test --config=playwright.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:lib": "npm pack ./dist/orc-ds",
    "verify:compatibility": "node tools/release/verify-compatibility.mjs",
    "verify:changelog-coverage": "node tools/release/verify-changelog-coverage.mjs",
    "verify:inventory": "node tools/quality/inventory.mjs --check",
    "generate:alias-parity": "node tools/quality/generate-alias-parity.mjs",
    "verify:alias-parity": "node tools/quality/generate-alias-parity.mjs --check",
    "verify:docs-integrity": "node tools/quality/verify-documentation-integrity.mjs",
    "docs:generate-api": "node tools/docs/generate-component-api.mjs",
    "verify:docs-api": "node tools/docs/generate-component-api.mjs --check",
    "verify:docs-coverage": "node tools/quality/check-docs-coverage.mjs",
    "verify:docs": "npm run verify:inventory && npm run verify:docs-integrity && npm run verify:docs-api && npm run verify:docs-coverage",
    "verify:package": "node tools/quality/verify-package.mjs",
    "verify:package:minimum": "node tools/quality/verify-package.mjs --minimum-angular",
    "verify:ssr": "node tools/quality/verify-ssr.mjs",
    "score:compatibility": "node tools/release/score-compatibility.mjs",
    "changeset": "changeset",
    "changeset:version": "node tools/release/version-packages.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@ciag/orchestra": "^22.0.1",
    "dompurify": "^3.4.15",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jasmine-axe": "^1.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
